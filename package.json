{
  "name": "3d-printer-status-card",
  "version": "1.0.0",
  "description": "A configurable Home Assistant status card for 3D printers, with optional smart-plug, camera, Spoolman, and macro support.",
  "type": "module",
  "main": "dist/printer-status-card.js",
  "files": [
    "dist/printer-status-card.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build:bundle": "rollup -c --bundleConfigAsCjs",
    "build:preview": "node scripts/build-preview.mjs",
    "build": "npm run build:bundle && npm run build:preview",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheGarmr/3d-printer-status-card.git"
  },
  "author": "TheGarmr",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheGarmr/3d-printer-status-card/issues"
  },
  "homepage": "https://github.com/TheGarmr/3d-printer-status-card#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.40.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.8.3"
  }
}
